# Telegram API 凭证（必填）
api_id: your_api_id
api_hash: your_api_hash
bot_token: your_bot_token  # Bot Token，用于 Bot 命令交互

# 媒体类型
media_types:
  - audio
  - document
  - photo
  - video
  - voice
  - animation

# 文件格式过滤（all = 所有格式）
file_formats:
  audio:
    - all
  document:
    - pdf
    - epub
  video:
    - mp4

# 下载设置
save_path: /app/downloads
file_path_prefix:
  - chat_title
  - media_datetime
file_name_prefix:
  - file_name
hide_file_name: false

#upload_drive:
#  enable_upload_file: false
#  remote_dir: drive:/telegram
#  before_upload_file_zip: True
#  after_upload_file_delete: True

# 并发控制
max_download_task: 5  # worker 数量

# WebUI
web_host: 0.0.0.0
web_port: 5000
web_login_secret: 123  # 登录密钥（当前未强制验证）

# 权限
allowed_user_ids:
  - 'me'  # 'me' = 当前登录账号

# 其他
language: ZH
date_format: '%Y_%m'
enable_download_txt: false
log_level: DEBUG

# 代理（Docker 内访问宿主机代理）
proxy:
  scheme: http
  hostname: 172.17.0.1
  port: 20172
